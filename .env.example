# Copy this file to `.env` and fill in values.
# `python-dotenv` loads `.env` from the project root (see `server.py`).

# Required — OpenAI for ingestion, storyboard, prompts, VO script, VLM text, end-card planning, etc.
OPENAI_API_KEY=

# Required — RunwayML for images, video, TTS, SFX (ElevenLabs-backed routes), VLM media tasks.
RUNWAYML_API_SECRET=

# Optional — set to 0 only if TLS verification fails behind corporate SSL inspection.
# Default is secure verification (see `pipeline/runway_client.py`).
# RUNWAY_SSL_VERIFY=1
